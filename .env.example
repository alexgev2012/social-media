# Template only: replace [YOUR-PASSWORD] and set this as DATABASE_URL in Render.
# Keep the real password in Render's environment settings, not in source control.
DATABASE_URL=postgresql://postgres.sijkjhlwycskrfpvwgaa:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Django production settings. Keep the real secret key in Render, not in Git.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=your-backend.onrender.com
FRONTEND_ORIGIN=https://your-frontend.onrender.com

# Supabase Storage S3 credentials are server-only. Create this bucket as public
# so public social media can render directly from the Supabase object URL.
SUPABASE_STORAGE_BUCKET=social-media
SUPABASE_STORAGE_REGION=
SUPABASE_STORAGE_ENDPOINT=
SUPABASE_STORAGE_PUBLIC_URL=
SUPABASE_STORAGE_ACCESS_KEY_ID=
SUPABASE_STORAGE_SECRET_ACCESS_KEY=
MAX_VIDEO_UPLOAD_SIZE=52428800
